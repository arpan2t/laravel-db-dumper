{
    "name": "arpan/laravel-db-dumper",
    "description": "A Laravel package for dumping MySQL databases.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=7.0",
        "illuminate/support": "^5.5|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Arpan\\DatabaseDumper\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arpan\\DatabaseDumper\\DatabaseDumperServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}